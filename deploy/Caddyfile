{$SITE_ADDRESS:localhost} {
    # Never compress streamed studio-voice audio: compression buffers it.
    @compressible not path /api/tts
    encode @compressible zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        Permissions-Policy "microphone=(self), camera=()"
        -Server
    }
    # Listener pages (/e/...) may be embedded by the sites in EMBED_ORIGINS
    # (Cvent, your website); every other page refuses framing.
    @embeddable path /e/*
    header @embeddable Content-Security-Policy "frame-ancestors 'self' {$EMBED_ORIGINS:}"
    @notembeddable not path /e/*
    header @notembeddable X-Frame-Options DENY
    handle /api/* {
        reverse_proxy backend:8001 {
            # Stream audio chunks to the operator as soon as they arrive.
            flush_interval -1
            # Overwrite client-supplied forwarding headers at the only ingress.
            header_up X-Forwarded-For {remote_host}
        }
    }
    handle {
        root * /srv
        @static path /assets/*
        header @static Cache-Control "public, max-age=31536000, immutable"
        @shell not path /assets/*
        header @shell Cache-Control "no-cache"
        try_files {path} /index.html
        file_server
    }
}
