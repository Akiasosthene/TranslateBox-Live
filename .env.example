# Production DNS names pointing to your server (comma separated); Caddy obtains HTTPS automatically.
SITE_ADDRESS=syntova.cloud, www.syntova.cloud
CORS_ORIGINS=https://syntova.cloud,https://www.syntova.cloud
OPENAI_API_KEY=
# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# This is an operator access code, NOT an OpenAI key. Minimum 32 characters.
OPERATOR_TOKEN=
OPENAI_REALTIME_MODEL=gpt-realtime-translate
# Studio voices (fixed voice chosen by the operator).
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Studio-voice sentences per minute per operator IP.
TTS_RATE_LIMIT_MAX=300
# Post-session AI summaries (OpenAI Responses API).
OPENAI_SUMMARY_MODEL=gpt-6-luna
# Listener languages per event (each one is a separate translation session).
MAX_LANGUAGES_PER_EVENT=5
MAX_LISTENERS=300
# Monthly cap on AI broadcast minutes (all languages); 0 = no cap.
USAGE_CAP_MINUTES=0
# Sites allowed to embed listener pages (space separated), e.g. https://web.cvent.com
EMBED_ORIGINS=
# Optional operator single sign-on (OpenID Connect). Redirect URI to register:
#   https://<your domain>/api/auth/sso/callback
# Google: OIDC_ISSUER=https://accounts.google.com
# Microsoft: OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
PUBLIC_ORIGIN=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Allowed accounts: emails and/or @domains, comma separated.
OIDC_ALLOWED=
OIDC_LABEL=Google
# Role given to new accounts created by single sign-on (presenter, admin, owner).
OIDC_DEFAULT_ROLE=presenter

# Stream ingest (RTMP / SRT through the "ingest" service). Open these ports in the firewall.
# INGEST_PUBLIC_HOST defaults to the host of PUBLIC_ORIGIN.
INGEST_PUBLIC_HOST=
INGEST_RTMP_PORT=1935
INGEST_SRT_PORT=8890
# Set only when RTMPS is configured on the ingest service (certificate mounted).
INGEST_RTMPS_PORT=
# Mobile apps: add https://localhost,capacitor://localhost to CORS_ORIGINS.
# Studio voice / text-pipeline translation model (empty = gpt-4.1-mini, fast; a bigger model is heard as delay) and server-mode idle stop.
OPENAI_CASCADE_MODEL=

# Premium studio voice (optional). With both keys set, "Studio voice" in the
# console uses Deepgram for recognition and ElevenLabs Flash for the voice:
# stable, natural voices, faster first word. Without them OpenAI does both.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=multi
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_VOICE_ID=
SERVER_IDLE_MINUTES=30

# Email for each demo request from the website (optional). Hostinger mail: smtp.hostinger.com, port 465.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
LEADS_NOTIFY_TO=

# Minute packs sold with Stripe Checkout (optional). Create the prices in Stripe, then:
# MINUTE_PACKS=minutes:price_id:display price, comma separated.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MINUTE_PACKS=300:price_xxx:49 $,1000:price_yyy:149 $
